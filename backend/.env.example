PORT=your_port
NODE_ENV=your_env

DATABASE_PASSWORD=your_password
DATABASE_DATABASE=your_db

# ── PostgreSQL local (Docker) — fallback ─────────────────────────────
# DATABASE_URL="postgresql://postgres:your_password@localhost:5432/your_db"

# ── Supabase — session pooler (conexión activa) DIRECT_URL ──────────────────────
DATABASE_URL="postgres://postgres.<project-ref>:<db-password>@aws-<region>.pooler.supabase.com:5432/postgres"

JWT_SECRET=your_jwt_secret

CORS_ORIGINS=domains

CLOUDINARY_URL=cloudinary://your_cloud_name:your_api_key@your_api_secret
